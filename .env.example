# First-party web
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Fastify API
API_HOST=0.0.0.0
API_PORT=4000
API_CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info
DATABASE_ADMIN_URL=postgresql://sports_migrator:sports_migrator_local@localhost:55432/sports_management
DATABASE_RUNTIME_URL=postgresql://sports_runtime:sports_runtime_local@localhost:55432/sports_management
DATABASE_AUTH_URL=postgresql://sports_auth:sports_auth_local@localhost:55432/sports_management?options=-c%20search_path%3Dauth
DATABASE_POOL_MAX=10
BETTER_AUTH_BASE_URL=http://localhost:4000
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
VALKEY_URL=redis://localhost:56379

# Worker
OUTBOX_POLL_INTERVAL_MS=2000
WORKER_HEARTBEAT_INTERVAL_MS=30000

# OpenTelemetry (leave endpoint empty to disable export locally)
OTEL_EXPORTER_OTLP_ENDPOINT=

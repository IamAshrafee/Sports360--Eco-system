{
  "name": "@sports/persistence",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "migrate": "node --import tsx src/cli/migrate.ts",
    "provision:local": "node --import tsx src/cli/provision-local.ts",
    "seed": "node --import tsx src/cli/seed.ts",
    "test": "vitest run --exclude '**/*.integration.test.ts'",
    "test:integration": "vitest run src/security.integration.test.ts src/configuration.integration.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@sports/contracts": "workspace:*",
    "@sports/domain": "workspace:*",
    "kysely": "0.29.4",
    "pg": "8.22.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/pg": "8.20.0",
    "tsx": "4.23.1"
  }
}

{
  "name": "sports-venue-management",
  "version": "0.0.0",
  "private": true,
  "description": "Bangladesh-first sports venue business management SaaS.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.17.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.18.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "11.17.0",
      "onFail": "error"
    }
  },
  "engines": {
    "node": ">=24.18.0 <25",
    "pnpm": "11.17.0"
  },
  "scripts": {
    "ai:context": "node scripts/ai-context.mjs",
    "ai:handoff": "node scripts/ai-handoff.mjs",
    "ai:verify": "corepack pnpm check",
    "ai:verify:full": "corepack pnpm api:generate && corepack pnpm check:all && corepack pnpm build",
    "api:generate": "corepack pnpm --filter @sports/api openapi:write && openapi-ts --input docs/specification/openapi.json --output packages/api-client/src/generated",
    "backup:local": "scripts/backup-local.sh",
    "build": "corepack pnpm --recursive --if-present build",
    "check": "corepack pnpm verify:runtime && corepack pnpm lint && corepack pnpm typecheck && corepack pnpm test && corepack pnpm format:check",
    "check:all": "corepack pnpm check && corepack pnpm db:migrate && corepack pnpm db:seed && corepack pnpm test:integration",
    "db:migrate": "corepack pnpm --filter @sports/persistence migrate",
    "db:provision:local": "corepack pnpm --filter @sports/persistence provision:local",
    "db:seed": "corepack pnpm --filter @sports/persistence seed",
    "dev:api": "corepack pnpm --filter @sports/api dev",
    "dev:web": "corepack pnpm --filter @sports/web dev",
    "dev:worker": "corepack pnpm --filter @sports/worker dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "infra:down": "docker compose down",
    "infra:up": "docker compose up --detach --wait && corepack pnpm db:provision:local",
    "lint": "eslint . --max-warnings=0",
    "preinstall": "node scripts/verify-runtime.mjs",
    "restore:drill": "scripts/restore-drill-local.sh",
    "test": "corepack pnpm --recursive --if-present test",
    "test:integration": "corepack pnpm --recursive --if-present test:integration",
    "typecheck": "corepack pnpm --recursive --if-present typecheck",
    "verify:runtime": "node scripts/verify-runtime.mjs"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.13.3",
    "@hey-api/openapi-ts": "0.99.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.11",
    "eslint-config-prettier": "10.1.8",
    "jsdom": "29.1.1",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
